# Public contact links. Leave a value empty to show the service as unavailable.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_KAKAOTALK_URL=
NEXT_PUBLIC_VK_URL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/mikhailfur
NEXT_PUBLIC_TWITCH_URL=
NEXT_PUBLIC_XBOX_URL=

# Private server-side token for Ynison now-playing. Never prefix this value with NEXT_PUBLIC_.
YANDEX_MUSIC_TOKEN=

# Private Telegram Bot API credentials used by the terminal `message` command.
# Start a private chat with the bot before setting TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Private OpenRouter key used for Miyabi AI chat and article translation.
OPENROUTER_API_KEY=
# Override only if OpenRouter uses a different Gemma 4 31B model identifier for your account.
OPENROUTER_MODEL=google/gemma-4-31b-it

# MiniMax Text-to-Speech (T2A) API settings for Miyabi voice messages
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=female-shaonv
MINIMAX_TTS_MODEL=speech-2.8-hd

