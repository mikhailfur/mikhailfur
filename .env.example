# MiniMax Text-to-Speech (T2A) API settings for Miyabi AI voice synthesis
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=female-shaonv
MINIMAX_TTS_MODEL=speech-2.8-hd

# ----------------------------------------------------
# STORAGE ARCHITECTURE (UPSTASH REDIS + MYSQL DATABASE)
# ----------------------------------------------------

# Upstash Redis REST API (Used ONLY for admin sessions & Miyabi AI rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MySQL Database (Used for permanent products catalog & customer orders storage)
# Supports connection string (MYSQL_URL/DATABASE_URL) OR individual parameters
MYSQL_URL=
# OR:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mikhail_store


